{
    "name": "tvtcommerce/module-admin-audit-log",
    "description": "Free admin action audit log for Magento 2 — records who did what and when across the entire admin panel.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "authors": [
        {
            "name": "TVT Commerce",
            "email": "toantv@tvtcommerce.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "magento/framework": ">=103.0.8",
        "magento/module-backend": ">=102.0.8",
        "magento/module-config": ">=101.2.8",
        "magento/module-cron": ">=100.4.8",
        "magento/module-store": ">=101.1.8",
        "magento/module-ui": ">=101.2.8"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "TVTCommerce\\AdminAuditLog\\": ""
        }
    },
    "archive": {
        "exclude": ["/tests", "/.gitignore"]
    }
}
