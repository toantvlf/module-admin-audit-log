<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="tvt_admin_audit_log_cleanup" instance="TVTCommerce\AdminAuditLog\Cron\CleanupOldLogs" method="execute">
            <!-- 02:30 server time, daily (off-peak). No-ops immediately if the module is
                 disabled — see Cron\CleanupOldLogs and Model\Config::isEnabled(). -->
            <schedule>30 2 * * *</schedule>
        </job>
    </group>
</config>
